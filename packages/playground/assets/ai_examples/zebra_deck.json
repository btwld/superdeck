      "sections": [
        {
          "type": "section",
          "flex": 2,
          "blocks": [
            {
              "type": "block",
              "align": "center",
              "content": "## \"The future of the zebra depends on protecting the wild spaces they call home.\"\n\n##### — Conservation Call"
            }
          ]
        }
      ],
      "options": {
        "title": "Conservation Imperative"
      }
